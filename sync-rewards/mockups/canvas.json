    "loop": { "fill": "teal", "size": 24, "text": "The loop\n\nTwo goals always on screen: a small one (next level, about $36 away) and a big one (next rank, the course unlock). Every top-up pack shows exactly what level and rank it gets you to, so the next purchase always has a visible payoff.", "w": 520, "x": 600, "y": 924 },
    "rules": { "fill": "orange", "size": 24, "text": "Earning rules (proposal, tune before launch)\n\n• 10 XP per $1 AUD of wallet credit bought\n• Bigger packs add bonus XP: $100 +5%, $250 +10%, $500 +15%, $1,000 +20%\n• 1 level = 1,000 XP ($100)\n• Ranks by lifetime credit: Bronze $0 · Silver $500 · Gold $1,500 · Platinum $4,000 · Black $10,000\n• Silver unlocks Elite Scale, Gold unlocks VIP Inner Circle", "w": 520, "x": 0, "y": 924 },
    "title": { "kind": "title1", "maxW": 1800, "text": "Sync Rewards: buy wallet credit, earn XP, rank up, unlock courses", "w": 240, "x": 0, "y": -260 },
